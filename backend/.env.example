# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=theia
DB_PASSWORD=theia_dev_password
DB_NAME=theia_chat
